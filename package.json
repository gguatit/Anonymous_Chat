{
  "name": "anonymous-chat",
  "version": "1.0.0",
  "type": "module",
  "description": "Anonymous real-time chat application using Cloudflare Workers and Pages",
  "main": "src/worker.js",
  "scripts": {
    "dev": "npm run css && npm run bundle && wrangler pages dev public",
    "build": "npm run css && npm run bundle && npm run lint",
    "deploy": "npm run css && npm run bundle && wrangler deploy",
    "css": "npx tailwindcss -i src/tailwind-input.css -o public/css/tailwind.min.css --minify",
    "bundle": "node esbuild.config.js",
    "lint": "eslint src/ public/js/",
    "lint:fix": "eslint src/ public/js/ --fix",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "websocket",
    "chat",
    "anonymous"
  ],
  "author": "",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260714.1",
    "@eslint/js": "^9.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "happy-dom": "^20.10.1",
    "tailwindcss": "^3.4.19",
    "vitest": "^4.1.8",
    "wrangler": "^4.110.0"
  },
  "dependencies": {
    "prismjs": "^1.30.0"
  }
}
